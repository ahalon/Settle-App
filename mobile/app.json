{
  "expo": {
    "name": "SettleApp",
    "slug": "settleup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/settle_app_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.settleup.app"
    },
    "android": {
      "package": "com.settleup.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/settle_app_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/settle_app_logo.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Settle-App"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "3d084c4b-b5de-4a93-8d27-3d69bead1657"
      }
    }
  }
}
